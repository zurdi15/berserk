<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v0.13.2: receiver que POSTEA la notificación sonora del fin de
             descanso cuando dispara la alarma (ver BkOngoingPlugin) -->
        <receiver android:name=".BkRestEndReceiver" android:exported="false" />

        <!-- v0.34.0: la alarma que vibra hasta el OK (shortService desde la
             alarma exacta, como en el reloj); v0.35.0: abre la app normal y la
             web pinta el overlay -->
        <service
            android:name=".BkAlarmService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- v0.28.0 reloj: órdenes del Galaxy Watch (cancelar cuenta atrás)
             por MessageClient; Play services lo arranca aunque la app esté
             cerrada. El estado hacia el reloj va por DataItems (BkWear). -->
        <service android:name=".BkWearListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/berserk/cmd/" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.31.0: Live Updates de Android 16 (chip, bloqueo, Now Bar) — permiso
         de manifiesto, no de runtime; el usuario puede vetarlo por app -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v0.34.0: alarma de fin en bucle (shortService) y su pantalla sobre el bloqueo -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- v0.16.0: setAlarmClock (aviso de fin de descanso, BkOngoingPlugin)
         exige permiso de alarmas exactas en Android 13+ — sin él lanzaba
         SecurityException y la app se CERRABA al registrar una serie.
         USE_EXACT_ALARM (API 33+) se concede en la instalación para apps de
         alarmas/timers; SCHEDULE_EXACT_ALARM cubre Android 12 (auto-
         concedido al declararse en esas versiones). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
