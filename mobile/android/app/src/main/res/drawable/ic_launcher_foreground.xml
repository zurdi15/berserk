<?xml version="1.0" encoding="utf-8"?>
<!--
  Misma runa y mismo grosor de trazo que frontend/public/icons/berserk.svg
  (trazo 20 sobre 512 = 1.25 sobre 32). Vector en vez de los PNG por
  densidad que generaba el asset tool: se escala sin pérdida y el tamaño
  se ajusta tocando un número.

  v0.39.2: la runa mide ~52dp de alto, la keyline de Material para
  rectángulos verticales en iconos adaptativos (antes ~61dp: llenaba el
  85% del círculo visible y se veía demasiado grande en el launcher).
  La tinta del path va de (7.6, 0.9) a (24.3, 30.8) → escala 1.75 y
  traslación para centrarla en (54, 54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.75"
        android:scaleY="1.75"
        android:translateX="26.05"
        android:translateY="26.28">
        <path
            android:pathData="M16,1.5L16,30M16,5L13.5,2M16,5L18.5,2M11,5L8.5,7.5L16,15L23.5,7.5L21,5M16,15L8.5,22.5L16,30L23.5,22.5L16,15"
            android:strokeColor="@color/bk_aurora"
            android:strokeWidth="1.25"
            android:strokeLineCap="square"
            android:strokeLineJoin="miter" />
    </group>
</vector>
